<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Prtsc.App.Views"
        mc:Ignorable="d"
        x:Class="Prtsc.App.Views.WindowPickerDialog"
        Title="{DynamicResource L.Picker.Title}"
        Width="540" Height="460"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="True"
        Background="{DynamicResource Bg.Window}">

  <Grid RowDefinitions="Auto,*,Auto">

    <Border Grid.Row="0" Padding="18,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="5">
        <TextBlock Classes="h2" Text="{DynamicResource L.Picker.Title}" />
        <TextBlock Classes="hint" Text="{DynamicResource L.Picker.Lede}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="1" Margin="14,12" CornerRadius="8"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            Background="{DynamicResource Bg.Panel}">
      <ListBox Name="WindowList" Background="Transparent" BorderThickness="0"
               Padding="6" DoubleTapped="OnListDoubleTapped">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="local:WindowPickerDialog+Row">
            <StackPanel Margin="8,9" Spacing="3">
              <TextBlock Text="{Binding Title}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="mono hint" FontSize="10" Text="{Binding SubText}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <Border Grid.Row="2" Padding="14,12" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Name="RefreshButton" Classes="ghost"
                Content="{DynamicResource L.Common.Refresh}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
          <Button Name="CancelButton" Content="{DynamicResource L.Common.Cancel}" />
          <Button Name="OkButton" Classes="primary" IsDefault="True"
                  Content="{DynamicResource L.Picker.Capture}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
