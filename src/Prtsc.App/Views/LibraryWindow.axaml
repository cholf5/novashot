<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Prtsc.App.ViewModels"
        mc:Ignorable="d"
        x:Class="Prtsc.App.Views.LibraryWindow"
        x:DataType="vm:LibraryViewModel"
        Title="{DynamicResource L.Library.Title}"
        Width="760" Height="560"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg.Window}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- header -->
    <Border Grid.Row="0" Padding="16,14" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <TextBlock Classes="h2" Text="{DynamicResource L.Library.Title}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="mono hint" FontSize="10.5" Margin="10,0,0,0"
                   Text="{Binding CountText}" VerticalAlignment="Center" />
        <Button Grid.Column="3" Classes="icon" Click="OnRefreshClick"
                ToolTip.Tip="{DynamicResource L.Common.Refresh}">
          <Path Classes="glyph" Data="{DynamicResource Icon.Refresh}" />
        </Button>
      </Grid>
    </Border>

    <!-- list -->
    <ListBox Grid.Row="1" Name="EntriesList" ItemsSource="{Binding Entries}"
             SelectedItem="{Binding Selected}" DoubleTapped="OnEntryDoubleTapped"
             KeyDown="OnListKeyDown"
             Background="Transparent" BorderThickness="0" Padding="8,6">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryEntryViewModel">
          <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,8" VerticalAlignment="Center">
            <Border Width="60" Height="40" CornerRadius="5" ClipToBounds="True"
                    Background="{DynamicResource Bg.Mat}" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1">
              <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="3">
              <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="mono hint" FontSize="10" Text="{Binding DetailsText}" />
            </StackPanel>
            <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                    Background="#1A10B981" IsVisible="{Binding HasRemote}">
              <TextBlock FontSize="10.5" Foreground="{DynamicResource Success}" Text="{Binding ProviderText}" />
            </Border>
            <Border Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                    Background="#12FFFFFF" IsVisible="{Binding !HasRemote}">
              <TextBlock FontSize="10.5" Foreground="{DynamicResource Ink.3}"
                         Text="{DynamicResource L.Library.LocalOnly}" />
            </Border>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- footer actions -->
    <Border Grid.Row="2" Padding="14,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="ghost danger" Click="OnDeleteClick" ToolTip.Tip="{DynamicResource L.Common.Delete}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Path Classes="glyph sm" Data="{DynamicResource Icon.Trash}" Stroke="{DynamicResource Danger}" />
            <TextBlock Text="{DynamicResource L.Common.Delete}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
          <Button Classes="ghost" Content="{DynamicResource L.Library.CopyPath}" Click="OnCopyPathClick" />
          <Button Classes="ghost" Content="{DynamicResource L.Library.CopyLink}" Click="OnCopyUrlClick" />
          <Button Classes="primary" Content="{DynamicResource L.Library.OpenImage}" Click="OnOpenLocalClick" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
