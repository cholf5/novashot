<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Prtsc.App.ViewModels"
        mc:Ignorable="d"
        x:Class="Prtsc.App.Views.LibraryWindow"
        x:DataType="vm:LibraryViewModel"
        Title="Prtsc Library"
        Width="720" Height="520"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

  <DockPanel Margin="12">
    <!-- 顶部标题 + 刷新 -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10" Spacing="8">
      <TextBlock Text="截图历史" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Name="RefreshButton" Content="刷新" Padding="10,4" VerticalAlignment="Center"
              Click="OnRefreshClick"/>
      <TextBlock Text="{Binding CountText}" VerticalAlignment="Center" Opacity="0.7" FontSize="12"/>
    </StackPanel>

    <!-- 底部操作条 -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0" Spacing="8"
                HorizontalAlignment="Right">
      <Button Name="CopyUrlButton" Content="复制链接" Padding="12,6"
              Click="OnCopyUrlClick"/>
      <Button Name="CopyPathButton" Content="复制路径" Padding="12,6"
              ToolTip.Tip="复制本地文件路径"
              Click="OnCopyPathClick"/>
      <Button Name="OpenLocalButton" Content="打开图片" Padding="12,6"
              Click="OnOpenLocalClick"/>
      <Button Name="DeleteButton" Content="删除记录" Padding="12,6"
              ToolTip.Tip="删除选中记录（Del/Backspace）"
              Click="OnDeleteClick"/>
      <Button Name="CloseButton" Content="关闭" Padding="12,6"
              Click="OnCloseClick"/>
    </StackPanel>

    <!-- 列表 -->
    <ListBox Name="EntriesList" ItemsSource="{Binding Entries}"
             SelectedItem="{Binding Selected}" DoubleTapped="OnEntryDoubleTapped"
             KeyDown="OnListKeyDown">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LibraryEntryViewModel">
          <Grid ColumnDefinitions="48,*,Auto,Auto" Margin="4" MinHeight="48">
            <Image Grid.Column="0" Width="44" Height="44" Stretch="Uniform"
                   Source="{Binding Thumbnail}"/>
            <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Text="{Binding DetailsText}" FontSize="11" Opacity="0.7"/>
            </StackPanel>
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0"
                       Text="{Binding ProviderText}" FontSize="11"
                       IsVisible="{Binding HasRemote}"/>
            <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="8,0"
                       Text="仅本地" FontSize="11" Opacity="0.5"
                       IsVisible="{Binding !HasRemote}"/>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
