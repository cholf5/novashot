<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Prtsc.App.ViewModels"
        xmlns:controls="using:Prtsc.App.Controls"
        xmlns:conv="using:Prtsc.App.Converters"
        mc:Ignorable="d"
        d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Prtsc.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Prtsc"
        MinWidth="800" MinHeight="600"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <conv:NullToBooleanConverter x:Key="NullToBool"/>
    <conv:EnumEqualsConverter x:Key="EnumEq"/>
  </Window.Resources>

  <Window.KeyBindings>
    <!-- Undo / Redo 只在编辑器态可用：CanExecute 由 EditorViewModel 控制 -->
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding Editor.UndoCommand}"/>
    <KeyBinding Gesture="Ctrl+Y" Command="{Binding Editor.RedoCommand}"/>
    <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding Editor.RedoCommand}"/>
    <!-- M4c.1: Delete 删除当前选中；Escape 取消选择 -->
    <KeyBinding Gesture="Delete" Command="{Binding Editor.DeleteSelectionCommand}"/>
    <KeyBinding Gesture="Back" Command="{Binding Editor.DeleteSelectionCommand}"/>
    <KeyBinding Gesture="Escape" Command="{Binding Editor.DeselectCommand}"/>
  </Window.KeyBindings>

  <DockPanel>
    <!-- Title bar area (placeholder) -->
    <Border DockPanel.Dock="Top" Height="40" Background="#22000000">
      <Grid ColumnDefinitions="*, Auto">
        <TextBlock Grid.Column="0"
                   Margin="16,0" VerticalAlignment="Center"
                   Text="Prtsc"
                   FontWeight="SemiBold" FontSize="14" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0">
          <Button Name="MinimizeToTrayButton"
                  Content="Minimize to tray"
                  Padding="10,4" Margin="4,0"
                  Click="OnMinimizeToTrayClick"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Height="26" Background="#11000000">
      <TextBlock Margin="12,0" VerticalAlignment="Center"
                 FontSize="12"
                 Text="{Binding StatusText}"/>
    </Border>

    <!-- Content: Capture toolbar OR Editor, switched by ViewModel.Mode -->
    <Panel>
      <!-- Capture idle view -->
      <StackPanel IsVisible="{Binding IsInCaptureMode}"
                  HorizontalAlignment="Center" VerticalAlignment="Center"
                  Spacing="16" Width="520">
        <TextBlock Text="Capture" FontSize="28" FontWeight="Light" HorizontalAlignment="Center"/>
        <TextBlock Text="Pick a capture mode below or use a global hotkey."
                   Opacity="0.7" HorizontalAlignment="Center"/>
        <UniformGrid Columns="3" Margin="0,16,0,0">
          <Button Name="CaptureFullscreenButton"
                  Content="Fullscreen"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="6" Padding="12"
                  Click="OnCaptureFullscreenClick"/>
          <Button Name="CaptureRegionButton"
                  Content="Region"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="6" Padding="12"
                  Click="OnCaptureRegionClick"/>
          <Button Name="CaptureWindowButton"
                  Content="Window"
                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  Margin="6" Padding="12"
                  Click="OnCaptureWindowClick"/>
        </UniformGrid>
        <TextBlock Margin="0,20,0,0" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"
                   Text="Global hotkeys: PrintScreen / Ctrl+PrintScreen / Ctrl+Shift+PrintScreen"/>
        <!-- M6c: 剪贴板粘贴 → 新编辑会话 -->
        <Button Name="PasteFromClipboardButton"
                Content="Paste from Clipboard (Ctrl+V)"
                Margin="0,8,0,0" Padding="12,8"
                HorizontalAlignment="Stretch"
                Command="{Binding PasteFromClipboardCommand}"
                ToolTip.Tip="Open an image from the clipboard in the editor"/>
      </StackPanel>

      <!-- Editor view (M4b: full tool palette + Undo/Redo + SkiaCanvas) -->
      <Grid IsVisible="{Binding IsInEditorMode}" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Height="44" Background="#18000000">
          <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center" Spacing="4">
            <Button Name="EditorBackButton" Content="← Back"
                    Padding="10,4"
                    Click="OnEditorBackClick"/>
            <Border Width="1" Margin="6,4" Background="#33FFFFFF"/>
            <!-- 工具选择：RadioButton group 保证单选。tag 承载 ToolKind 值；IsChecked 单向绑定
                 保证热键改 CurrentTool 时按钮视觉同步。M4d 加了字母热键 V R E O A L T N S。 -->
            <RadioButton GroupName="Tool" Content="Sel"     Padding="8,4" Tag="Select"        Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Select}"
                         ToolTip.Tip="Select / move / resize (V)"/>
            <RadioButton GroupName="Tool" Content="Rect"    Padding="8,4" Tag="Rectangle"     Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Rectangle}"
                         ToolTip.Tip="Rectangle (R)"/>
            <RadioButton GroupName="Tool" Content="Ellipse" Padding="8,4" Tag="Ellipse"       Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Ellipse}"
                         ToolTip.Tip="Ellipse (E)"/>
            <RadioButton GroupName="Tool" Content="Line"    Padding="8,4" Tag="Line"          Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Line}"
                         ToolTip.Tip="Line (L)"/>
            <RadioButton GroupName="Tool" Content="Arrow"   Padding="8,4" Tag="ArrowStraight" Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=ArrowStraight}"
                         ToolTip.Tip="Arrow (A)"/>
            <RadioButton GroupName="Tool" Content="Curve"   Padding="8,4" Tag="ArrowCurved"   Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=ArrowCurved}"
                         ToolTip.Tip="Curved arrow (O)"/>
            <RadioButton GroupName="Tool" Content="Text"    Padding="8,4" Tag="Text"          Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Text}"
                         ToolTip.Tip="Text (T)"/>
            <RadioButton GroupName="Tool" Content="#"       Padding="8,4" Tag="Number"        Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Number}"
                         ToolTip.Tip="Number counter (N)"/>
            <RadioButton GroupName="Tool" Content="Spot"    Padding="8,4" Tag="Spotlight"     Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Spotlight}"
                         ToolTip.Tip="Spotlight (S)"/>
            <!-- M5: Flameshot 补齐工具 -->
            <RadioButton GroupName="Tool" Content="Pen"     Padding="8,4" Tag="Pencil"        Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Pencil}"
                         ToolTip.Tip="Pencil (P)"/>
            <RadioButton GroupName="Tool" Content="High"    Padding="8,4" Tag="Highlighter"   Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Highlighter}"
                         ToolTip.Tip="Highlighter (H)"/>
            <RadioButton GroupName="Tool" Content="Mosaic"  Padding="8,4" Tag="Mosaic"        Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Mosaic}"
                         ToolTip.Tip="Pixelate region (M) — Ctrl+Wheel adjusts block size"/>
            <RadioButton GroupName="Tool" Content="Blur"    Padding="8,4" Tag="Blur"          Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Blur}"
                         ToolTip.Tip="Blur region (B) — Ctrl+Wheel adjusts strength"/>
            <RadioButton GroupName="Tool" Content="Inv"     Padding="8,4" Tag="Invert"        Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Invert}"
                         ToolTip.Tip="Invert colors (I)"/>
            <!-- M6d: 非破坏裁剪（X） -->
            <RadioButton GroupName="Tool" Content="Crop"    Padding="8,4" Tag="Crop"          Click="OnToolChanged"
                         IsChecked="{Binding Editor.CurrentTool, Mode=OneWay, Converter={StaticResource EnumEq}, ConverterParameter=Crop}"
                         ToolTip.Tip="Crop (X) — drag a region; non-destructive"/>
            <Border Width="1" Margin="6,4" Background="#33FFFFFF"/>
            <Button Content="Delete (Del)" Padding="10,4"
                    Command="{Binding Editor.DeleteSelectionCommand}"/>
            <Border Width="1" Margin="6,4" Background="#33FFFFFF"/>
            <Button Content="Undo (Ctrl+Z)" Padding="10,4"
                    Command="{Binding Editor.UndoCommand}"/>
            <Button Content="Redo (Ctrl+Y)" Padding="10,4"
                    Command="{Binding Editor.RedoCommand}"/>
            <Border Width="1" Margin="6,4" Background="#33FFFFFF"/>
            <!-- M6a: 导出（格式由保存对话框扩展名决定：png/jpg/webp） -->
            <Button Content="Save (Ctrl+S)" Padding="10,4"
                    ToolTip.Tip="Export as PNG / JPEG / WebP (format follows file extension)"
                    Click="OnExportClick"/>
            <!-- M6c: 复制到剪贴板 / 快存（命令在主 VM 上，直接绑定根级属性） -->
            <Button Content="Copy (Ctrl+C)" Padding="10,4"
                    ToolTip.Tip="Copy composed image to clipboard (CF_DIBV5 + CF_DIB)"
                    Command="{Binding CopyCommand}"/>
            <Button Content="Quick Save (Ctrl+Q)" Padding="10,4"
                    ToolTip.Tip="Save directly to the QuickSave folder (no dialog, follows config)"
                    Command="{Binding QuickSaveCommand}"/>
            <!-- M7b: 云上传 / 历史 / Pin / 云设置 -->
            <Button Content="Upload" Padding="10,4"
                    ToolTip.Tip="Upload to configured cloud (R2/Google Drive), URL copied (Ctrl+U)"
                    Command="{Binding UploadCommand}"/>
            <Button Content="Library" Padding="10,4"
                    ToolTip.Tip="Screenshot history (Ctrl+L)"
                    Click="OnLibraryClick"/>
            <Button Content="Pin" Padding="10,4"
                    ToolTip.Tip="Pin composed image to screen (Ctrl+P)"
                    Command="{Binding PinCommand}"/>
            <Button Content="Cloud…" Padding="10,4"
                    ToolTip.Tip="Cloud upload settings"
                    Click="OnCloudSettingsClick"/>
          </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="#0A000000">
          <Grid ColumnDefinitions="*,Auto">
            <!-- 画布 + 浮动 TextBox 编辑层 -->
            <Grid Grid.Column="0">
              <controls:SkiaCanvas x:Name="Canvas" Editor="{Binding Editor}" Margin="8"/>
              <Canvas x:Name="TextEditLayer"
                      IsHitTestVisible="{Binding Editor.EditingText, Converter={StaticResource NullToBool}}"
                      Background="Transparent">
                <TextBox x:Name="TextEditBox"
                         IsVisible="{Binding Editor.EditingText, Converter={StaticResource NullToBool}}"
                         Text="{Binding Editor.EditingTextValue, Mode=TwoWay}"
                         Canvas.Left="{Binding Editor.EditingTextDipBounds.X}"
                         Canvas.Top="{Binding Editor.EditingTextDipBounds.Y}"
                         Width="{Binding Editor.EditingTextDipBounds.Width}"
                         MinWidth="80"
                         FontSize="{Binding Editor.EditingTextFontSizeDip}"
                         AcceptsReturn="False"
                         LostFocus="OnTextEditLostFocus">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter"  Command="{Binding Editor.CommitTextEditCommand}"/>
                    <KeyBinding Gesture="Escape" Command="{Binding Editor.CancelTextEditCommand}"/>
                  </TextBox.KeyBindings>
                </TextBox>
              </Canvas>
            </Grid>

            <!-- 右侧属性面板：标注样式 + 合成外观（M6b），可滚动 -->
            <Border Grid.Column="1" Width="240" Background="#22000000">
              <ScrollViewer>
                <StackPanel Spacing="10">
                  <controls:StylePanel DataContext="{Binding Editor.StylePanel}"/>
                  <Border Height="1" Background="#33FFFFFF" Margin="0,2"/>
                  <controls:CompositionPanel DataContext="{Binding Editor.CompositionPanelViewModel}"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Panel>
  </DockPanel>
</Window>
