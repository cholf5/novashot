<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Prtsc.App.ViewModels"
             xmlns:controls="using:Prtsc.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="240" d:DesignHeight="360"
             x:Class="Prtsc.App.Controls.StylePanel"
             x:DataType="vm:StylePanelViewModel">

  <UserControl.Styles>
    <!-- 单个色块按钮：40×28，四角圆角，边框在有 IsChecked 时高亮 -->
    <Style Selector="ToggleButton.swatch">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="ToggleButton.swatch:checked">
      <Setter Property="BorderBrush" Value="#FFFFFFFF"/>
    </Style>
    <Style Selector="ToggleButton.swatch:pointerover">
      <Setter Property="BorderBrush" Value="#66FFFFFF"/>
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="10" Margin="10">
    <TextBlock Text="Style" FontSize="14" FontWeight="SemiBold" Opacity="0.85"/>

    <!-- 颜色调色板：8 色 4 列 2 行 -->
    <ItemsControl x:Name="ColorSwatches" ItemsSource="{Binding PresetColors}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4"/>
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <!-- 通过 code-behind Click 处理颜色切换：ToggleButton.Tag 记录 SKColor -->
          <ToggleButton Classes="swatch"
                        Click="OnSwatchClick"
                        Tag="{Binding}">
            <ToggleButton.Background>
              <SolidColorBrush Color="{Binding Converter={x:Static controls:SKColorToAvaloniaColorConverter.Instance}}"/>
            </ToggleButton.Background>
          </ToggleButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Stroke width -->
    <StackPanel Spacing="4">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Stroke" FontSize="12" Opacity="0.8"/>
        <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6"
                   Text="{Binding StrokeWidth, StringFormat={}{0:0}}"/>
      </Grid>
      <Slider Minimum="1" Maximum="16"
              TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding StrokeWidth, Mode=TwoWay}"/>
    </StackPanel>

    <!-- Font size (仅 Text 场景) -->
    <StackPanel Spacing="4" IsVisible="{Binding IsFontSizeAvailable}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Font" FontSize="12" Opacity="0.8"/>
        <TextBlock Grid.Column="1" FontSize="12" Opacity="0.6"
                   Text="{Binding FontSize, StringFormat={}{0:0}}"/>
      </Grid>
      <Slider Minimum="12" Maximum="72"
              TickFrequency="2" IsSnapToTickEnabled="True"
              Value="{Binding FontSize, Mode=TwoWay}"/>
    </StackPanel>

    <Border Height="1" Background="#33FFFFFF" Margin="0,4"/>
    <TextBlock FontSize="11" Opacity="0.5"
               Text="{Binding SelectionKindLabel, StringFormat=Selection: {0}}"/>
  </StackPanel>
</UserControl>
