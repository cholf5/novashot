<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="Prtsc.App.Controls.FloatingToolRing"
             Focusable="False">

  <UserControl.Styles>
    <Style Selector="Button.ring">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ring:pointerover">
      <Setter Property="Background" Value="{DynamicResource Hover.Strong}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    </Style>
    <Style Selector="Button.ring.accent">
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
    </Style>
    <Style Selector="Button.ring.accent:pointerover">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
    </Style>
    <Style Selector="Button.ring.danger:pointerover">
      <Setter Property="Background" Value="#26E8837E" />
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
  </UserControl.Styles>

  <Border Background="{DynamicResource Bg.Dock}" CornerRadius="10" Padding="4"
          BorderBrush="{DynamicResource Line}" BorderThickness="1">
    <Border.BoxShadow>
      <BoxShadows>0 10 28 -8 #CC000000</BoxShadows>
    </Border.BoxShadow>
    <StackPanel Orientation="Horizontal" Spacing="2">
      <Button Name="CancelButton" Classes="ring danger" Content="✕"
              ToolTip.Tip="{DynamicResource L.Ring.Cancel}" />
      <Border Width="1" Background="{DynamicResource Line}" Margin="2,6" />
      <Button Name="ConfirmButton" Classes="ring accent" Content="✓"
              ToolTip.Tip="{DynamicResource L.Ring.Confirm}" />
    </StackPanel>
  </Border>
</UserControl>
