<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Prtsc.App.Controls">

  <Styles.Resources>

    <!-- ===================== Button ===================== -->
    <ControlTheme x:Key="ButtonTheme" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
      </Style>
      <Style Selector="^:pressed">
        <Setter Property="Background" Value="{DynamicResource Hover.Strong}" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.35" />
      </Style>

      <!-- 白色实心：每个界面只允许一个 -->
      <Style Selector="^.primary">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
      </Style>
      <Style Selector="^.primary:pointerover">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="#FFFFFF" />
      </Style>
      <Style Selector="^.primary:pressed">
        <Setter Property="Background" Value="#D6D6DA" />
        <Setter Property="BorderBrush" Value="#D6D6DA" />
      </Style>

      <!-- 无边框文字按钮 -->
      <Style Selector="^.ghost">
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      </Style>
      <Style Selector="^.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
        <Setter Property="Background" Value="{DynamicResource Hover}" />
      </Style>
      <Style Selector="^.ghost.danger">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
      </Style>
      <Style Selector="^.ghost.danger:pointerover">
        <Setter Property="Background" Value="#1AE8837E" />
      </Style>

      <!-- 填充型次级按钮 -->
      <Style Selector="^.quiet">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      </Style>
      <Style Selector="^.quiet:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover.Strong}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>

      <!-- 截图模式里的一行命令（左侧图标 + 文案 + 右侧键帽） -->
      <Style Selector="^.cmd">
        <Setter Property="Height" Value="46" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontWeight" Value="Normal" />
      </Style>
      <Style Selector="^.cmd:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="BorderBrush" Value="Transparent" />
      </Style>

      <!-- 纯图标 -->
      <Style Selector="^.icon">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
        <Setter Property="CornerRadius" Value="6" />
      </Style>
      <Style Selector="^.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^.icon:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Ink.4}" />
        <Setter Property="Opacity" Value="1" />
      </Style>
    </ControlTheme>

    <!-- ===================== ToggleButton ===================== -->
    <ControlTheme x:Key="ToggleTheme" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
      </Style>

      <!-- 分段控件（Style / Canvas） -->
      <Style Selector="^.seg">
        <Setter Property="Height" Value="24" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>
      <Style Selector="^.seg:checked">
        <Setter Property="Background" Value="{DynamicResource Bg.Raise}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^.seg:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg.Raise}" />
      </Style>

      <!-- 色块 -->
      <Style Selector="^.swatch">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="2" />
      </Style>
      <!-- E-1 M9：历史行用小号色块（5 列装下最近 10 色） -->
      <Style Selector="^.swatch.small">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style Selector="^.swatch:pointerover">
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
      </Style>
      <Style Selector="^.swatch:checked">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      </Style>

      <!-- 渐变格子 -->
      <Style Selector="^.grad">
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Margin" Value="2" />
      </Style>
      <Style Selector="^.grad:pointerover">
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
      </Style>
      <Style Selector="^.grad:checked">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      </Style>
    </ControlTheme>

    <!-- ===================== Tool chip (RadioButton) ===================== -->
    <ControlTheme x:Key="ToolChipTheme" TargetType="RadioButton">
      <Setter Property="Width" Value="37" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
      </Style>
      <Style Selector="^:checked:pointerover">
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource Accent.Ink}" />
      </Style>
    </ControlTheme>

    <!-- ===================== Radio chip (segmented) ===================== -->
    <ControlTheme x:Key="RadioChipTheme" TargetType="RadioButton">
      <Setter Property="Height" Value="24" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^:checked">
        <Setter Property="Background" Value="{DynamicResource Bg.Raise}" />
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^:checked:pointerover">
        <Setter Property="Background" Value="{DynamicResource Bg.Raise}" />
      </Style>
    </ControlTheme>

    <!-- ===================== Slider ===================== -->
    <ControlTheme x:Key="SliderThumbTheme" TargetType="Thumb">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Width="12" Height="12" CornerRadius="6"
                  Background="{DynamicResource Accent}"
                  BorderBrush="{DynamicResource Bg.Panel}"
                  BorderThickness="2" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="SliderTheme" TargetType="Slider">
      <Setter Property="Height" Value="18" />
      <Setter Property="MinWidth" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Height="18" VerticalAlignment="Center">
            <!-- 槽（贯穿全宽；Avalonia 12 的 Track 不给按钮分配宽度，填充段改由槽 + 圆点表达） -->
            <Border Height="3" CornerRadius="2" VerticalAlignment="Center"
                    Background="{DynamicResource Line.Strong}" />
            <Track Name="PART_Track"
                   Minimum="{TemplateBinding Minimum}"
                   Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}"
                   Orientation="{TemplateBinding Orientation}">
              <Track.DecreaseButton>
                <RepeatButton Name="PART_DecreaseButton" Focusable="False" Background="Transparent" />
              </Track.DecreaseButton>
              <Track.IncreaseButton>
                <RepeatButton Name="PART_IncreaseButton" Focusable="False" Background="Transparent" />
              </Track.IncreaseButton>
              <Thumb Theme="{StaticResource SliderThumbTheme}" />
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>

    <!-- ===================== CheckBox ===================== -->
    <ControlTheme x:Key="CheckBoxTheme" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border" Background="{TemplateBinding Background}" Padding="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Name="box" Width="15" Height="15" CornerRadius="4"
                      BorderBrush="{DynamicResource Line.Strong}" BorderThickness="1"
                      Background="Transparent" VerticalAlignment="Center">
                <Path Name="check" Data="{DynamicResource Icon.Check}"
                      Stroke="{DynamicResource Accent.Ink}" StrokeThickness="2"
                      Width="9" Height="9" Stretch="Uniform"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="False" />
              </Border>
              <ContentPresenter Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Ink}" />
      </Style>
      <Style Selector="^:checked /template/ Border#box">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
      </Style>
      <Style Selector="^:checked /template/ Path#check">
        <Setter Property="IsVisible" Value="True" />
      </Style>
      <Style Selector="^:disabled">
        <Setter Property="Opacity" Value="0.4" />
      </Style>
    </ControlTheme>

    <!-- ===================== List row ===================== -->
    <ControlTheme x:Key="RowItemTheme" TargetType="ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="PART_Border"
                  Background="{TemplateBinding Background}"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="Stretch" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource Hover}" />
      </Style>
      <Style Selector="^:selected /template/ Border#PART_Border">
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
      </Style>
    </ControlTheme>

    <!-- ===================== Keycap ===================== -->
    <ControlTheme x:Key="KeycapTheme" TargetType="controls:Keycap">
      <Setter Property="Background" Value="{DynamicResource Keycap}" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
      <Setter Property="MinWidth" Value="18" />
      <Setter Property="Height" Value="17" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="#1FFFFFFF" BorderThickness="1"
                  CornerRadius="4" Padding="4,0">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^.on-accent">
        <Setter Property="Background" Value="{DynamicResource Keycap.OnAccent}" />
        <Setter Property="Foreground" Value="#4A4A4E" />
      </Style>
    </ControlTheme>

  </Styles.Resources>

  <Style Selector="RadioButton.chip">
    <Setter Property="Theme" Value="{StaticResource RadioChipTheme}" />
  </Style>


  <!-- 把主题挂到控件上 -->
    <Style Selector="Button">
      <Setter Property="Theme" Value="{StaticResource ButtonTheme}" />
    </Style>

    <Style Selector="ToggleButton">
      <Setter Property="Theme" Value="{StaticResource ToggleTheme}" />
    </Style>

    <Style Selector="RadioButton.tool">
      <Setter Property="Theme" Value="{StaticResource ToolChipTheme}" />
    </Style>

    <Style Selector="Slider">
      <Setter Property="Theme" Value="{StaticResource SliderTheme}" />
    </Style>

    <Style Selector="CheckBox">
      <Setter Property="Theme" Value="{StaticResource CheckBoxTheme}" />
    </Style>

    <Style Selector="ListBoxItem">
      <Setter Property="Theme" Value="{StaticResource RowItemTheme}" />
    </Style>


  <!-- ===================== global element styles ===================== -->

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource Font.UI}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Bg.Window}" />
  </Style>

  <!-- numerals: every measurement in the app is mono + tabular -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="-0.2" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.sec">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
  </Style>
  <Style Selector="TextBlock.val">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Foreground" Value="{DynamicResource Ink.3}" />
  </Style>
  <Style Selector="TextBlock.dim">
    <Setter Property="Foreground" Value="{DynamicResource Ink.3}" />
  </Style>

  <Style Selector="Path.glyph">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Ink.2}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Path.glyph.solid">
    <Setter Property="Fill" Value="{DynamicResource Ink.2}" />
    <Setter Property="Stroke" Value="Transparent" />
  </Style>
  <Style Selector="Path.glyph.dash">
    <Setter Property="StrokeDashArray" Value="3,2.5" />
  </Style>
  <Style Selector="Path.glyph.sm">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <!-- ===================== TextBox / ComboBox ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="8,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SelectionBrush" Value="#40EDEDEF" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="#33FFFFFF" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource Bg.Inset}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- ===================== ToolTip ===================== -->
  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#F226262C" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="Padding" Value="7,4" />
  </Style>

  <!-- ===================== Menu (flyouts) ===================== -->
  <Style Selector="MenuFlyoutPresenter">
    <Setter Property="Background" Value="#F226262C" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="4" />
  </Style>
  <Style Selector="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="9,5" />
  </Style>

</Styles>
