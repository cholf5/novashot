<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Novashot.App.ViewModels"
             xmlns:controls="using:Novashot.App.Controls"
             mc:Ignorable="d"
             d:DesignWidth="264" d:DesignHeight="620"
             x:Class="Novashot.App.Controls.StylePanel"
             x:DataType="vm:StylePanelViewModel">

  <!--
  Inspector 双态（M-Inspector）：
  - 未选中 = 默认样式态：只有公共组（颜色 / 描边宽）
  - 选中   = 对象态：公共组 + 几何组（X/Y/宽/高，开放形状宽高禁用）+ 效果组（Mosaic/Blur）+ 层序组
  样式与效果改动不进 Undo；几何写值走既有 Move/Resize 命令（进 Undo）。
  -->

  <StackPanel Margin="12,14,12,4" Spacing="16">

    <!-- 公共组 · Colour：界面里唯一鲜艳的东西 -->
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
        <TextBlock Classes="sec" Text="{DynamicResource L.Panel.Colour}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding StrokeHex}" />
      </Grid>
      <ItemsControl x:Name="ColorSwatches" ItemsSource="{Binding PresetColors}" Margin="-2,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <!-- 颜色切换走 code-behind（Tag 承载 SKColor） -->
            <ToggleButton Classes="swatch" Click="OnSwatchClick" Tag="{Binding}">
              <ToggleButton.Background>
                <SolidColorBrush Color="{Binding Converter={x:Static controls:SKColorToAvaloniaColorConverter.Instance}}" />
              </ToggleButton.Background>
            </ToggleButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- E-1 M9：取色历史行（会话级最近 10 色，最新在前；点历史色 = 设为描边色）。空则整行隐藏 -->
      <StackPanel IsVisible="{Binding HasColorHistory}" Margin="0,6,0,0">
        <TextBlock Classes="label" Text="{DynamicResource L.Panel.History}" Margin="0,0,0,4" />
        <ItemsControl x:Name="HistorySwatches" ItemsSource="{Binding HistoryColors}" Margin="-2,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="5" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <ToggleButton Classes="swatch small" Click="OnSwatchClick" Tag="{Binding}"
                             ToolTip.Tip="{Binding}">
                <ToggleButton.Background>
                  <SolidColorBrush Color="{Binding Converter={x:Static controls:SKColorToAvaloniaColorConverter.Instance}}" />
                </ToggleButton.Background>
              </ToggleButton>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>

    <!-- 公共组 · Stroke -->
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="label" Text="{DynamicResource L.Panel.Stroke}" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding StrokeWidth, StringFormat='{}{0:0} px'}" />
      </Grid>
      <Slider Minimum="1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
              Value="{Binding StrokeWidth, Mode=TwoWay}" Margin="0,3,0,0" />
      <Grid ColumnDefinitions="*,*,*">
        <TextBlock Classes="mono hint" FontSize="9.5" Text="1" />
        <TextBlock Grid.Column="1" Classes="mono hint" FontSize="9.5" Text="8" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="mono hint" FontSize="9.5" Text="16" HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>

    <!-- 几何组（选中时显示；X/Y 全类型可编辑，宽高仅盒状族） -->
    <StackPanel IsVisible="{Binding IsGeometryVisible}">
      <TextBlock Classes="label" Text="{DynamicResource L.Panel.Geometry}" Margin="0,0,0,4" />
      <UniformGrid Columns="2">
        <StackPanel Margin="0,0,6,4">
          <TextBlock Classes="hint" FontSize="9.5" Text="X" Margin="1,0,0,2" />
          <NumericUpDown Value="{Binding SelX, Mode=TwoWay}" Minimum="0" Maximum="10000"
                         Increment="1" FormatString="0" Height="30" />
        </StackPanel>
        <StackPanel Margin="6,0,0,4">
          <TextBlock Classes="hint" FontSize="9.5" Text="Y" Margin="1,0,0,2" />
          <NumericUpDown Value="{Binding SelY, Mode=TwoWay}" Minimum="0" Maximum="10000"
                         Increment="1" FormatString="0" Height="30" />
        </StackPanel>
        <StackPanel Margin="0,0,6,0">
          <TextBlock Classes="hint" FontSize="9.5" Text="{DynamicResource L.Panel.Width}" Margin="1,0,0,2" />
          <NumericUpDown Value="{Binding SelW, Mode=TwoWay}" Minimum="4" Maximum="10000"
                         Increment="1" FormatString="0" Height="30"
                         IsEnabled="{Binding IsSizeEditable}"
                         ToolTip.Tip="{DynamicResource L.Panel.GeometryReadonlyHint}" />
        </StackPanel>
        <StackPanel Margin="6,0,0,0">
          <TextBlock Classes="hint" FontSize="9.5" Text="{DynamicResource L.Panel.Height}" Margin="1,0,0,2" />
          <NumericUpDown Value="{Binding SelH, Mode=TwoWay}" Minimum="4" Maximum="10000"
                         Increment="1" FormatString="0" Height="30"
                         IsEnabled="{Binding IsSizeEditable}"
                         ToolTip.Tip="{DynamicResource L.Panel.GeometryReadonlyHint}" />
        </StackPanel>
      </UniformGrid>
    </StackPanel>

    <!-- 效果组（Mosaic/Blur）：颗粒度 / 强度 -->
    <StackPanel IsVisible="{Binding IsEffectVisible}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="label" Text="{Binding EffectLabel}" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding EffectStrength, StringFormat='{}{0:0}'}" />
      </Grid>
      <Slider Minimum="{Binding EffectMin}" Maximum="{Binding EffectMax}"
              Value="{Binding EffectStrength, Mode=TwoWay}" Margin="0,3,0,0" />
    </StackPanel>

    <!-- Font size（仅文字） -->
    <StackPanel IsVisible="{Binding IsFontSizeAvailable}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="label" Text="{DynamicResource L.Panel.TextSize}" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding FontSize, StringFormat='{}{0:0}'}" />
      </Grid>
      <Slider Minimum="12" Maximum="72" TickFrequency="2" IsSnapToTickEnabled="True"
              Value="{Binding FontSize, Mode=TwoWay}" Margin="0,3,0,0" />
      <Grid ColumnDefinitions="*,*,*">
        <TextBlock Classes="mono hint" FontSize="9.5" Text="12" />
        <TextBlock Grid.Column="1" Classes="mono hint" FontSize="9.5" Text="42" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="2" Classes="mono hint" FontSize="9.5" Text="72" HorizontalAlignment="Right" />
      </Grid>
    </StackPanel>

    <Border Height="1" Background="{DynamicResource Line}" Margin="0,2" />

    <!-- 层序组（选中时显示；命令路径与元素列表/画布共用，进 Undo）。
         左两枚 = 置顶/置底（跨度），右两枚 = 逐层 上移/下移。 -->
    <StackPanel IsVisible="{Binding HasSelection}">
      <TextBlock Classes="label" Text="{DynamicResource L.Panel.Layer}" Margin="0,0,0,4" />
      <UniformGrid Columns="4">
        <Button Classes="layer-btn" Command="{Binding Editor.BringToFrontCommand}"
                ToolTip.Tip="{DynamicResource L.Panel.ToTop}" Content="⤒" />
        <Button Classes="layer-btn" Command="{Binding Editor.SendToBackCommand}"
                ToolTip.Tip="{DynamicResource L.Panel.ToBottom}" Content="⤓" />
        <Button Classes="layer-btn" Command="{Binding Editor.BringForwardCommand}"
                ToolTip.Tip="{DynamicResource L.Panel.Up}" Content="↑" />
        <Button Classes="layer-btn" Command="{Binding Editor.SendBackwardCommand}"
                ToolTip.Tip="{DynamicResource L.Panel.Down}" Content="↓" />
      </UniformGrid>
    </StackPanel>

    <Border Height="1" Background="{DynamicResource Line}" Margin="0,2" />

    <!-- 当前选中 -->
    <StackPanel>
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="sec" Text="{DynamicResource L.Panel.Selection}" />
        <TextBlock Grid.Column="1" Classes="val" Text="{Binding SelectionKindLabel}" />
      </Grid>
    </StackPanel>

  </StackPanel>
</UserControl>
