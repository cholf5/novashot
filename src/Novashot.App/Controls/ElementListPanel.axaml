<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Novashot.App.ViewModels"
             xmlns:conv="using:Novashot.App.Converters"
             mc:Ignorable="d"
             d:DesignWidth="200" d:DesignHeight="420"
             x:Class="Novashot.App.Controls.ElementListPanel"
             x:DataType="vm:EditorViewModel"
             IsVisible="{Binding HasElements}">

  <UserControl.Resources>
    <conv:IconKeyToGeometryConverter x:Key="IconKeyToGeometry" />
  </UserControl.Resources>

  <StackPanel Margin="8,10,8,4" Spacing="8">

    <!-- 标题行 + 折叠开关 -->
    <Grid ColumnDefinitions="*,Auto" Margin="4,0,0,0">
      <TextBlock Classes="sec" Text="{DynamicResource L.Panel.Elements}" VerticalAlignment="Center" />
      <ToggleButton x:Name="CollapseToggle" Grid.Column="1" Classes="icon" IsChecked="True"
                    HorizontalContentAlignment="Center">
        <Path Classes="glyph" Width="10" Height="10"
              Data="M 1,3 L 5,7 L 9,3" Stroke="{Binding $parent[ToggleButton].Foreground}" />
      </ToggleButton>
    </Grid>

    <ItemsControl x:Name="ElementListItems" ItemsSource="{Binding ElementList}"
                  IsVisible="{Binding #CollapseToggle.IsChecked}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ElementListItemViewModel">
          <!-- Q-1 规矩：IsChecked OneWay 回显 + Click 携带状态，目标侧不回写源 -->
          <RadioButton Classes="element-row" GroupName="ElementRows"
                       IsChecked="{Binding IsSelected, Mode=OneWay}"
                       Click="OnRowClick" Tag="{Binding}"
                       ToolTip.Tip="{Binding Summary}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,3">
              <Path Classes="glyph" Width="14" Height="14" Margin="0,0,8,0"
                    Data="{Binding IconKey, Converter={StaticResource IconKeyToGeometry}}"
                    Stroke="{Binding $parent[RadioButton].Foreground}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center"
                         FontSize="11.5" TextTrimming="CharacterEllipsis" />
              <!-- hover 显露：透明度全权交给主题样式（.element-row:pointerover / :selected） -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="1" Classes="row-actions"
                          VerticalAlignment="Center">
                <Button Classes="icon row-action" Click="OnMoveUpClick" Tag="{Binding}"
                        ToolTip.Tip="{DynamicResource L.Panel.Up}" Content="↑" />
                <Button Classes="icon row-action" Click="OnMoveDownClick" Tag="{Binding}"
                        ToolTip.Tip="{DynamicResource L.Panel.Down}" Content="↓" />
              </StackPanel>
            </Grid>
          </RadioButton>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
