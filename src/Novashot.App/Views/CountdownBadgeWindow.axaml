<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Novashot.App.Views.CountdownBadgeWindow"
        Title="Novashot.Delay"
        WindowDecorations="None"
        Background="Transparent"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

  <!-- D-1 延时倒计时角标：数字 + 取消提示。到点/取消都会被 App 关闭，且关闭后 ≥250ms 才抓帧，不会进快照 -->
  <Border Name="BadgeBorder" CornerRadius="10" Padding="20,14"
          Background="{DynamicResource Bg.Overlay}"
          BorderBrush="{DynamicResource Line}" BorderThickness="1"
          BoxShadow="0 4 16 0 #66000000">
    <StackPanel Spacing="5">
      <TextBlock Name="SecondsText" FontSize="30" FontWeight="Bold"
                 Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" Text="3" />
      <TextBlock FontSize="10.5" Foreground="{DynamicResource Ink.2}" HorizontalAlignment="Center"
                 Text="{DynamicResource L.Delay.BadgeCancelHint}" />
    </StackPanel>
  </Border>
</Window>
