<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="Novashot.App.Views.CaptureLauncherWindow"
        Title="{DynamicResource L.Launcher.Title}"
        Width="440"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}">

  <Window.Styles>
    <Style Selector="TextBlock.flabel">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Ink.2}" />
      <Setter Property="Margin" Value="0,0,0,5" />
    </Style>
  </Window.Styles>

  <StackPanel Margin="20,16" Spacing="14">

    <TextBlock Classes="h2" Text="{DynamicResource L.Launcher.Title}" />

    <!-- 模式 -->
    <StackPanel Spacing="6">
      <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.Mode}" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <RadioButton Name="ModeRegion" Classes="chip" GroupName="LauncherMode" IsChecked="True"
                     Content="{DynamicResource L.Launcher.ModeRegion}" Click="OnModeClick" />
        <RadioButton Name="ModeFullscreen" Classes="chip" GroupName="LauncherMode"
                     Content="{DynamicResource L.Launcher.ModeFullscreen}" Click="OnModeClick" />
      </StackPanel>
    </StackPanel>

    <!-- 区域几何（仅区域模式） -->
    <StackPanel Name="GeometryHost" Spacing="6">
      <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.Geometry}" />
      <Grid ColumnDefinitions="*,*,*,*">
        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,8,0">
          <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.X}" />
          <TextBox Name="XBox" Text="0" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,8,0">
          <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.Y}" />
          <TextBox Name="YBox" Text="0" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,8,0">
          <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.W}" />
          <TextBox Name="WBox" Text="1920" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="4">
          <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.H}" />
          <TextBox Name="HBox" Text="1080" />
        </StackPanel>
      </Grid>
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="{DynamicResource L.Launcher.GeometryHint}" />
      <TextBlock Name="ErrorText" IsVisible="False" TextWrapping="Wrap"
                 FontSize="11.5" Foreground="#ef4444" />
    </StackPanel>

    <!-- 延时 -->
    <StackPanel Spacing="6">
      <TextBlock Classes="flabel" Text="{DynamicResource L.Launcher.Delay}" />
      <ComboBox Name="DelayBox" MinWidth="160" HorizontalAlignment="Left">
        <ComboBoxItem Content="{DynamicResource L.Launcher.Delay0}" />
        <ComboBoxItem Content="{DynamicResource L.Launcher.Delay3}" />
        <ComboBoxItem Content="{DynamicResource L.Launcher.Delay5}" />
      </ComboBox>
    </StackPanel>

    <Button Name="StartButton" Classes="primary" HorizontalAlignment="Left" MinWidth="130"
            Content="{DynamicResource L.Launcher.Start}" Click="OnStartClick" />

  </StackPanel>
</Window>
