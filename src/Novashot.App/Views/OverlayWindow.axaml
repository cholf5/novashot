<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Novashot.App.Controls"
        mc:Ignorable="d"
        x:Class="Novashot.App.Views.OverlayWindow"
        Title="Novashot.Overlay"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Background="Black">

  <Panel>
    <Image Name="BackgroundImage" Stretch="Fill"/>

    <!-- 选框 + 暗化 + 8 handles + 光标切换 -->
    <controls:SelectionAdorner Name="Adorner"/>

    <!-- 悬浮工具环层：Canvas 允许绝对定位；无 Background 使自身不可命中，
         避免拦截下层 SelectionAdorner 的鼠标输入（透明背景在 Avalonia 中仍参与命中测试） -->
    <Canvas Name="ToolRingLayer">
      <controls:FloatingToolRing Name="ToolRing" IsVisible="False"/>
    </Canvas>

    <!-- E-1 M9 取色模式：放大镜 + HEX/RGB 浮签。盖在工具环之上独占指针输入；
         只在取色模式 IsVisible=true 时参与渲染与命中，常态选框零开销 -->
    <controls:ColorMagnifier Name="ColorMagnifier" IsVisible="False"/>

    <!-- 底部 hint（选框阶段） -->
    <Border Name="DefaultHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            Background="{DynamicResource Bg.Overlay}" CornerRadius="8" Padding="14,8"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            IsHitTestVisible="False">
      <TextBlock Foreground="{DynamicResource Ink}" FontSize="11.5"
                 Text="{DynamicResource L.Overlay.Hint}"/>
    </Border>

    <!-- 底部 hint（取色模式） -->
    <Border Name="PickerHint" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
            Background="{DynamicResource Bg.Overlay}" CornerRadius="8" Padding="14,8"
            BorderBrush="{DynamicResource Line}" BorderThickness="1"
            IsHitTestVisible="False" IsVisible="False">
      <TextBlock Foreground="{DynamicResource Ink}" FontSize="11.5"
                 Text="{DynamicResource L.Overlay.PickerHint}"/>
    </Border>
  </Panel>
</Window>
