<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Novashot design tokens
       仪器面板：中性灰打底（画布衬底绝对中性，不给截图加色偏），
       界面上唯一鲜艳的东西是用户选中的标注颜色。
       ============================================================ -->

  <!-- Type -->
  <FontFamily x:Key="Font.UI">avares://Novashot/Assets/Fonts#IBM Plex Sans</FontFamily>
  <FontFamily x:Key="Font.Mono">avares://Novashot/Assets/Fonts#IBM Plex Mono</FontFamily>

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Bg.Mat" Color="#141416" />
  <SolidColorBrush x:Key="Bg.Window" Color="#1B1B1E" />
  <SolidColorBrush x:Key="Bg.Panel" Color="#212125" />
  <SolidColorBrush x:Key="Bg.Raise" Color="#27272C" />
  <SolidColorBrush x:Key="Bg.Dock" Color="#232328" />
  <SolidColorBrush x:Key="Bg.Inset" Color="#0B000000" />
  <SolidColorBrush x:Key="Bg.Overlay" Color="#CC16161A" />

  <!-- Lines -->
  <SolidColorBrush x:Key="Line" Color="#12FFFFFF" />
  <SolidColorBrush x:Key="Line.Strong" Color="#20FFFFFF" />

  <!-- Interaction -->
  <SolidColorBrush x:Key="Hover" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Hover.Strong" Color="#1AFFFFFF" />

  <!-- Ink -->
  <SolidColorBrush x:Key="Ink" Color="#ECECEF" />
  <SolidColorBrush x:Key="Ink.2" Color="#9B9BA3" />
  <SolidColorBrush x:Key="Ink.3" Color="#6A6A73" />
  <SolidColorBrush x:Key="Ink.4" Color="#4E4E56" />
  <SolidColorBrush x:Key="Ink.Inverse" Color="#151517" />

  <!-- Controls -->
  <SolidColorBrush x:Key="Accent" Color="#EDEDEF" />
  <SolidColorBrush x:Key="Accent.Ink" Color="#151517" />
  <SolidColorBrush x:Key="Keycap" Color="#2C2C31" />
  <SolidColorBrush x:Key="Keycap.OnAccent" Color="#24000000" />
  <SolidColorBrush x:Key="Danger" Color="#E8837E" />
  <SolidColorBrush x:Key="Success" Color="#4ADE9B" />

  <!-- Annotation palette (single source of truth, mirrored in StylePanelViewModel) -->
  <SolidColorBrush x:Key="Palette.Red" Color="#E53E3E" />
  <SolidColorBrush x:Key="Palette.Orange" Color="#F59E0B" />
  <SolidColorBrush x:Key="Palette.Yellow" Color="#FCD34D" />
  <SolidColorBrush x:Key="Palette.Green" Color="#10B981" />
  <SolidColorBrush x:Key="Palette.Blue" Color="#3B82F6" />
  <SolidColorBrush x:Key="Palette.Purple" Color="#8B5CF6" />
  <SolidColorBrush x:Key="Palette.Light" Color="#F3F4F6" />
  <SolidColorBrush x:Key="Palette.Dark" Color="#1F2937" />

  <!-- Metrics -->
  <CornerRadius x:Key="Radius.Sm">5</CornerRadius>
  <CornerRadius x:Key="Radius.Md">7</CornerRadius>
  <CornerRadius x:Key="Radius.Lg">11</CornerRadius>

</ResourceDictionary>
