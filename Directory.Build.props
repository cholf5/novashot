<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 警告即错误：新增警告要么修掉，要么在下面写明理由后 NoWarn（当噪声压掉会重新长回来）。
         注意 XAML 编译器诊断（AVLN*）不受此属性管辖，唯一生效通道是仓库根的 .editorconfig。 -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1701</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>cholf5</Company>
    <Product>Prtsc</Product>
    <Copyright>Copyright (c) $([System.DateTime]::Now.Year) cholf5</Copyright>

    <!-- 许可证元数据唯一出处：全解决方案（src + tests）统一继承，勿在各 csproj 重复声明。
         LICENSE 全文在仓库根目录；README「许可」一节有条款摘要与字体例外说明。 -->
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Authors>cholf5</Authors>

    <!-- Repository layout -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)\obj\</BaseIntermediateOutputPath>

    <!-- App 双 TFM 后，mac/linux 也能构建 windows TFM 腿（Windows 机上本就是默认行为） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <!-- Linux 平台层：全部 P/Invoke 仅在 Linux 语义下可达（运行时按 OS 分流装配），交叉编译时告警无意义 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Prtsc.Platform.Linux'">
    <NoWarn>$(NoWarn);CA1416;CA2014;CS0067</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
